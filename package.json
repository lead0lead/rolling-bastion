{
  "name": "rolling-bastion",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run -c vitest.bench.config.ts --silent=false",
    "sim": "vitest run -c vitest.sim.config.ts --silent=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim:balance": "vitest run -c vitest.sim.config.ts --silent=false balance",
    "sim:weapons": "vitest run -c vitest.sim.config.ts --silent=false weapons",
    "sim:endless": "SIM_ENDLESS=12 vitest run -c vitest.sim.config.ts --silent=false balance"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
